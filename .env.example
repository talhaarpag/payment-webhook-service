# Copy to .env (or export) before running. Get the real value from `stripe listen` or the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_local_dev_secret
DB_PATH=webhooks.db
SIGNATURE_TOLERANCE=300
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=30
RETRY_INTERVAL=15
# Optional: protects GET /payments, GET /events, POST /events/retry
ADMIN_API_KEY=
